{
  "name": "rustic-house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build:llms": "node scripts/generate-llms.mjs",
    "build:next": "next build",
    "build:opennext": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js build",
    "build": "pnpm build:llms && pnpm build:next",
    "preview": "pnpm build && pnpm build:opennext && wrangler dev",
    "deploy:dry": "pnpm build && pnpm build:opennext && wrangler deploy --dry-run --outdir=dist",
    "deploy": "pnpm build && pnpm build:opennext && wrangler deploy",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:jsonld": "node scripts/validate-jsonld.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "@gsap/react": "^2.1.2",
    "lenis": "^1.3.26",
    "next": "^15.5.7",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.7",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0"
  },
  "engines": { "node": ">=20.0.0" },
  "packageManager": "pnpm@9.15.9"
}
